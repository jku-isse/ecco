{
  "name": "ecco",
  "displayName": "ECCO",
  "description": "Shows which features each line of an ECCO checkout is traced to.",
  "version": "0.1.0",
  "publisher": "ecco",
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/.ecco/*"
  ],
  "contributes": {
    "configuration": {
      "title": "ECCO",
      "properties": {
        "ecco.serverPath": {
          "type": "string",
          "default": "",
          "description": "The ecco-lsp launcher (lsp/build/install/ecco-lsp/bin/ecco-lsp after ./gradlew :ecco-lsp:installDist). Empty: the one built beside this extension in the repository, else ecco-lsp on the PATH."
        },
        "ecco.javaHome": {
          "type": "string",
          "default": "",
          "description": "A Java 21 (or later) installation for the server. Empty: JAVA_HOME, or java on the PATH - which an editor started from the Dock or Finder may not have."
        },
        "ecco.featureColours": {
          "type": "boolean",
          "default": true,
          "description": "Colour code by feature: each condition its own background, as in the GUI; code with the file's own condition stays uncoloured, code not committed is grey."
        }
      }
    },
    "commands": [
      {
        "command": "ecco.commit",
        "title": "ECCO: Commit…",
        "icon": "$(check)"
      },
      {
        "command": "ecco.checkout",
        "title": "ECCO: Check Out…",
        "icon": "$(versions)"
      },
      {
        "command": "ecco.restartServer",
        "title": "ECCO: Restart Language Server"
      },
      {
        "command": "ecco.toggleFeatureColours",
        "title": "ECCO: Toggle Feature Colours",
        "icon": "$(symbol-color)"
      },
      {
        "command": "ecco.foldFeature",
        "title": "ECCO: Fold Feature…",
        "icon": "$(fold)"
      },
      {
        "command": "ecco.foldOtherFeatures",
        "title": "ECCO: Fold All but Feature…",
        "icon": "$(eye)"
      },
      {
        "command": "ecco.unfoldFeatures",
        "title": "ECCO: Unfold Feature Blocks",
        "icon": "$(unfold)"
      },
      {
        "command": "ecco.revealLines",
        "title": "ECCO: Show Lines"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ecco.features",
          "name": "ECCO Features"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ecco.features",
        "contents": "Open a file of an ECCO checkout to see which features its lines are traced to."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ecco.revealLines",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "ecco.commit",
          "when": "view == ecco.features",
          "group": "navigation@0"
        },
        {
          "command": "ecco.checkout",
          "when": "view == ecco.features",
          "group": "navigation@0"
        },
        {
          "command": "ecco.unfoldFeatures",
          "when": "view == ecco.features",
          "group": "navigation@1"
        },
        {
          "command": "ecco.toggleFeatureColours",
          "when": "view == ecco.features",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ecco.foldFeature",
          "when": "view == ecco.features && viewItem == eccoCondition",
          "group": "inline@1"
        },
        {
          "command": "ecco.foldOtherFeatures",
          "when": "view == ecco.features && viewItem == eccoCondition",
          "group": "inline@2"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
