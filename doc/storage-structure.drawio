<mxfile host="ecco"><diagram name="Storage" id="storage"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;ECCO repository storage&lt;/b&gt; (Ser backend, October 2026)" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#1f3a5f;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c4" value="What &lt;code&gt;.ecco/&lt;/code&gt; holds, how the parts refer to each other, how a repository is loaded and how a write commits." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5f6670;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:14px&quot;&gt;.ecco/&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;&amp;lt;coreId&amp;gt;.ser.zip&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;associations/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;lt;associationId&amp;gt;.ser.zip&lt;/span&gt; &amp;nbsp;one per association&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;artifacts/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;&amp;nbsp;&amp;nbsp;pack-&amp;lt;writeId&amp;gt;.zip&lt;/span&gt; &amp;nbsp;one per write&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;.settings&lt;/span&gt; &amp;nbsp;how plugins read files (LilyPond tokens, ...)&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;.adapters&lt;/span&gt; &amp;nbsp;file pattern → adapter&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;.ignores&lt;/span&gt; &amp;nbsp;files never committed&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;write&lt;/span&gt; &amp;nbsp;lock file: one writer at a time&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#5f6670&quot;&gt;during a write only:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;*.&amp;lt;newCoreId&amp;gt;.pending&lt;/span&gt; &amp;nbsp;staged files&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;*.tmp&lt;/span&gt; &amp;nbsp;a file being written&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#5f6670&quot;&gt;All &lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;.zip&lt;/span&gt; files: one entry, Java serialization, compressed at the fastest level.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f8;strokeColor=#1f3a5f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="330" height="430" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;id&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Menlo,monospace;&quot;&gt;c5dbe0c8-…&lt;/span&gt;&lt;br&gt;the current core's name - &lt;b&gt;the commit point&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#c98a00;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;core&lt;/b&gt; &lt;span style=&quot;font-family:Menlo,monospace&quot;&gt;&amp;lt;coreId&amp;gt;.ser.zip&lt;/span&gt; &amp;nbsp;&lt;span style=&quot;color:#5f6670&quot;&gt;(small: 15 KB for flipperzero)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;• repository: features + revisions, constraints (accepted, rejected), modules (index of the counter lattice), max order&lt;br&gt;• commits: configuration, message, committer, date, &lt;b&gt;association ids&lt;/b&gt;&lt;br&gt;• &lt;b&gt;association ids&lt;/b&gt; of the repository&lt;br&gt;• &lt;b&gt;pack order&lt;/b&gt; + pack sizes (later pack wins)&lt;br&gt;• variants, remotes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="330" height="215" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;association&lt;/b&gt; &lt;span style=&quot;font-family:Menlo,monospace&quot;&gt;associations/&amp;lt;id&amp;gt;.ser.zip&lt;/span&gt;&lt;br&gt;&lt;br&gt;• id&lt;br&gt;• &lt;b&gt;artifact tree&lt;/b&gt;: nodes with&lt;br&gt;&amp;nbsp;&amp;nbsp;– unique flag, sequence number (position in the parent's order)&lt;br&gt;&amp;nbsp;&amp;nbsp;– &lt;b&gt;artifactId&lt;/b&gt; (not the artifact itself)&lt;br&gt;&amp;nbsp;&amp;nbsp;– properties (e.g. source lines), children&lt;br&gt;• &lt;b&gt;counter&lt;/b&gt;: how often its artifacts occurred with each feature combination (compact: ids + varints)&lt;br&gt;• cached minimized / checkout conditions&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#b03a2e&quot;&gt;Written whole when touched: one 93 MB tree per flipperzero commit for a few changed lines (gap #48).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="340" height="265" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;pack&lt;/b&gt; &lt;span style=&quot;font-family:Menlo,monospace&quot;&gt;artifacts/pack-&amp;lt;writeId&amp;gt;.zip&lt;/span&gt;&lt;br&gt;&lt;br&gt;entry &lt;span style=&quot;font-family:Menlo,monospace&quot;&gt;artifacts&lt;/span&gt;: the artifacts of one write, one serialization stream (class descriptions once):&lt;br&gt;&amp;nbsp;&amp;nbsp;– data (a line, a token, a Java statement, a pixel, …)&lt;br&gt;&amp;nbsp;&amp;nbsp;– ordered / atomic flags, references (uses)&lt;br&gt;&amp;nbsp;&amp;nbsp;– &lt;b&gt;order graph&lt;/b&gt; (POG) of an ordered artifact, its nodes refer to artifact ids&lt;br&gt;entry &lt;span style=&quot;font-family:Menlo,monospace&quot;&gt;digests&lt;/span&gt;: 16 bytes per artifact (half a SHA-256) - tells a later write what changed&lt;br&gt;&lt;br&gt;A later pack supersedes earlier copies of an artifact; packs mostly superseded are compacted, the smallest merged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1b8a7a;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="410" width="340" height="245" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;derived on load, not stored&lt;/b&gt;&lt;br&gt;&lt;br&gt;• node → artifact (from artifactId)&lt;br&gt;• artifact → containing node&lt;br&gt;• the main tree (built lazily)&lt;br&gt;• which pack holds each artifact (from the pack order)&lt;br&gt;• modified flags of artifacts (gap #49)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#5f6670;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1210" y="80" width="280" height="160" as="geometry"/></mxCell><mxCell id="c11" value="names" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c98a00;fontColor=#c98a00;fontSize=11;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="association ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2b5797;fontColor=#2b5797;fontSize=11;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="pack order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1b8a7a;fontColor=#1b8a7a;fontSize=11;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="artifactId → artifact&lt;br&gt;(shared by associations)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1b8a7a;fontColor=#1b8a7a;fontSize=11;endArrow=block;endFill=1;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Loading&lt;/b&gt; (open)" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1f3a5f;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="700" height="24" as="geometry"/></mxCell><mxCell id="c16" value="1  read &lt;span style='font-family:Menlo,monospace'&gt;id&lt;/span&gt;, finish a write interrupted after its commit point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="700" height="30" as="geometry"/></mxCell><mxCell id="c17" value="2  read the core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="628" width="700" height="30" as="geometry"/></mxCell><mxCell id="c18" value="3  read the packs in pack order - each artifact once, the latest copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="666" width="700" height="30" as="geometry"/></mxCell><mxCell id="c19" value="4  read the associations, resolve their nodes' artifact ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="704" width="700" height="30" as="geometry"/></mxCell><mxCell id="c20" value="5  derive what is not stored (containing nodes, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b5797;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="742" width="700" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Writing&lt;/b&gt; (a commit, pull, …): crash-safe in four steps - a failure before step 3 leaves the old state, after it the next open finishes" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1f3a5f;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1440" height="24" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;1  stage&lt;/b&gt;&lt;br&gt;new and changed artifacts → one new pack; touched associations → &lt;span style='font-family:Menlo,monospace'&gt;&amp;lt;id&amp;gt;.ser.zip.&amp;lt;newCoreId&amp;gt;.pending&lt;/span&gt;; unchanged ones skipped (digests, modified flags)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a5f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="835" width="345" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;2  core&lt;/b&gt;&lt;br&gt;write the new core &lt;span style='font-family:Menlo,monospace'&gt;&amp;lt;newCoreId&amp;gt;.ser.zip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a5f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="385" y="835" width="345" height="90" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6670;fontColor=#5f6670;fontSize=11;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;3  commit point&lt;/b&gt;&lt;br&gt;switch &lt;span style='font-family:Menlo,monospace'&gt;id&lt;/span&gt; to the new core (atomic rename)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#c98a00;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="750" y="835" width="345" height="90" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6670;fontColor=#5f6670;fontSize=11;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;4  publish&lt;/b&gt;&lt;br&gt;rename the pending files over the stable ones; delete superseded packs, removed associations, stale .tmp files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f3a5f;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;arcSize=6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1115" y="835" width="345" height="90" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5f6670;fontColor=#5f6670;fontSize=11;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;span style='color:#5f6670'&gt;A repository written by these builds cannot be opened by older ones (ordered packs, compact counters, text format markers, Java tree format 2). Remote sync sends the same entities as one serialization stream, with ECCO's classes only.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1a1a1a;align=left;verticalAlign=top;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="935" width="1440" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>